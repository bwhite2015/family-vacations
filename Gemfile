source "https://rubygems.org"

# Matches what GitHub Pages actually runs, so a local preview behaves like the
# live site. Only needed for previewing on your own machine — GitHub Pages
# ignores this file and uses its own pinned versions.
gem "github-pages", group: :jekyll_plugins

gem "webrick", "~> 1.8"   # Ruby 3+ no longer bundles this; jekyll serve needs it

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
end
